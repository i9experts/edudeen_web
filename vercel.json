{
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        { "key":  "X-Content-Type-Options", "value":  "nosniff" },
                                        { "key":  "X-Frame-Options", "value":  "SAMEORIGIN" },
                                        { "key":  "Referrer-Policy", "value":  "strict-origin-when-cross-origin" },
                                        { "key":  "Strict-Transport-Security", "value":  "max-age=15552000; includeSubDomains" },
                                        { "key":  "Permissions-Policy", "value":  "camera=(), microphone=(self), geolocation=(self), payment=(self)" }
                                    ]
                    }
                ],
    "rewrites":  [
                     {
                         "source":  "/robots.txt",
                         "destination":  "https://api.edudeen.com/robots.txt"
                     },
                     {
                         "source":  "/sitemap.xml",
                         "destination":  "https://api.edudeen.com/sitemap.xml"
                     },
                     {
                         "source":  "/sitemap-:suffix.xml",
                         "destination":  "https://api.edudeen.com/sitemap-:suffix.xml"
                     },
                     {
                         "source":  "/product/:slug",
                         "destination":  "https://api.edudeen.com/seo-render/product/:slug",
                         "has":  [
                                     {
                                         "type":  "header",
                                         "key":  "user-agent",
                                         "value":  ".*(Googlebot|Google-InspectionTool|AdsBot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|Baiduspider|Applebot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Pinterestbot).*"
                                     }
                                 ]
                     },
                     {
                         "source":  "/c/:slug",
                         "destination":  "https://api.edudeen.com/seo-render/category/:slug",
                         "has":  [
                                     {
                                         "type":  "header",
                                         "key":  "user-agent",
                                         "value":  ".*(Googlebot|Google-InspectionTool|AdsBot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|Baiduspider|Applebot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Pinterestbot).*"
                                     }
                                 ]
                     },
                     {
                         "source":  "/shop/:slug",
                         "destination":  "https://api.edudeen.com/seo-render/store/:slug",
                         "has":  [
                                     {
                                         "type":  "header",
                                         "key":  "user-agent",
                                         "value":  ".*(Googlebot|Google-InspectionTool|AdsBot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|Baiduspider|Applebot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Pinterestbot).*"
                                     }
                                 ]
                     },
                     {
                         "source":  "/:page(about|faq|contact-us|learn|premium|become-a-seller|privacy-policy|terms-of-service|cookie-policy)",
                         "destination":  "https://api.edudeen.com/seo-render/page/:page",
                         "has":  [
                                     {
                                         "type":  "header",
                                         "key":  "user-agent",
                                         "value":  ".*(Googlebot|Google-InspectionTool|AdsBot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|Baiduspider|Applebot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Pinterestbot).*"
                                     }
                                 ]
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ]
}